{
  "name": "packetlark",
  "displayName": "PacketLark",
  "description": "Open a local PacketLark workbench and run API collections inside VS Code.",
  "version": "1.1.0",
  "publisher": "packetlark",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Testing"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCommand:packetlark.openStudio"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "packetlark.openStudio",
        "title": "PacketLark: Open API Studio"
      },
      {
        "command": "packetlark.stopStudio",
        "title": "PacketLark: Stop API Studio"
      }
    ],
    "configuration": {
      "title": "PacketLark",
      "properties": {
        "packetlark.runtimePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to a built PacketLark checkout (npm ci && npm run build)."
        },
        "packetlark.nodePath": {
          "type": "string",
          "default": "node",
          "scope": "machine",
          "description": "Node.js 22+ executable."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abrar225/packetlark.git",
    "directory": "extensions/vscode"
  },
  "icon": "icon.png"
}
