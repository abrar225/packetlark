{
  "name": "rea-api-studio",
  "version": "1.0.0",
  "description": "Local API workbench with HTTP traffic capture and inferred OpenAPI exports",
  "type": "module",
  "bin": {
    "rea-api": "./bin/rea-api.js"
  },
  "scripts": {
    "build": "tsc && node scripts/build-web.mjs",
    "start": "node dist/server/index.js",
    "start:build": "npm run build && npm start",
    "dev": "npm run build && node --watch dist/server/index.js",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "build:web": "node scripts/build-web.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "animejs": "^4.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide": "^0.468.0"
  },
  "engines": {
    "node": ">=22"
  }
}
