{
  "name": "packetlark",
  "version": "1.1.0",
  "description": "Local API workbench with HTTP traffic capture and inferred OpenAPI exports",
  "type": "module",
  "bin": {
    "packetlark": "./bin/packetlark.js"
  },
  "scripts": {
    "build": "node scripts/build-sandbox.mjs && tsc && node scripts/build-web.mjs",
    "start": "node bin/packetlark.js studio",
    "start:build": "npm run build && npm start",
    "dev": "npm run build && node --watch dist/server/index.js",
    "test": "npm run check",
    "check": "npm run roadmap:check && npm run build && vitest run",
    "roadmap:check": "node scripts/roadmap-tracker.mjs",
    "roadmap:write": "node scripts/roadmap-tracker.mjs --write",
    "build:web": "node scripts/build-web.mjs",
    "build:extension": "tsc --noEmit --strict --skipLibCheck --esModuleInterop --target ES2022 --module NodeNext --moduleResolution NodeNext extensions/vscode/src/extension.ts && node scripts/build-extension.mjs",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.105.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "animejs": "^4.5.0",
    "chai": "6.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide": "^0.468.0",
    "oauth4webapi": "3.8.8",
    "quickjs-emscripten": "0.32.0",
    "tough-cookie": "6.0.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "dist",
    "public",
    "sandbox",
    "README.md",
    "LICENSE",
    "docs",
    "extensions/vscode/README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/abrar225/packetlark.git"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.2"
  }
}
