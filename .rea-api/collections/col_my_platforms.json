{
  "id": "col_my_platforms",
  "name": "My Platforms (Firehox & Abrar Akhunji)",
  "description": "Production monitoring, latency benchmarking, and endpoint reverse-engineering for firehox.com and abrarakhunji.com.",
  "schemaVersion": "2.1.0",
  "variables": [
    {
      "key": "firehoxUrl",
      "value": "https://firehox.com",
      "enabled": true
    },
    {
      "key": "abrarUrl",
      "value": "https://abrarakhunji.com",
      "enabled": true
    }
  ],
