      "name": "Firehox — Core Homepage",
      "request": {
        "id": "fh_home",
        "name": "Firehox — Core Homepage",
        "method": "GET",
        "url": "{{firehoxUrl}}",
        "headers": [
          {
            "key": "User-Agent",
            "value": "ReaAPI-Studio/1.0",
            "enabled": true
          },
          {
            "key": "Accept",
            "value": "text/html,application/xhtml+xml",
            "enabled": true
          }
        ],
        "queryParams": [],
        "body": {
          "mode": "none"
        },
        "auth": {
          "type": "none"
        },
        "testScript": "pm.test(\"Firehox root status is 200\", function() {\n  pm.expect(pm.response.code).to.equal(200);\n});\npm.test(\"CDN response time is healthy (< 8000ms)\", function() {\n  pm.expect(pm.response.responseTime).to.be.below(8000);\n});",
