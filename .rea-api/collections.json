            "mode": "none"
          },
          "auth": {
            "type": "none"
          },
          "testScript": "pm.test(\"Firehox root status is 200\", function() {\n  pm.expect(pm.response.code).to.equal(200);\n});\npm.test(\"CDN response time is healthy (< 8000ms)\", function() {\n  pm.expect(pm.response.responseTime).to.be.below(8000);\n});",
